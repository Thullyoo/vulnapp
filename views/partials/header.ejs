<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' · Deskly' : 'Deskly' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="shell">
    <aside class="sidebar">
      <div class="brand">Desk<span>ly</span></div>
      <nav class="nav">
        <a href="/" class="<%= active === 'home' ? 'active' : '' %>"><span class="nav-icon">##</span> Painel</a>
        <a href="/search" class="<%= active === 'search' ? 'active' : '' %>"><span class="nav-icon">?</span> Buscar tickets</a>
        <a href="/comments" class="<%= active === 'comments' ? 'active' : '' %>"><span class="nav-icon">~</span> Atividade</a>
        <a href="/ping" class="<%= active === 'ping' ? 'active' : '' %>"><span class="nav-icon">></span> Diagnostico de rede</a>
        <a href="/calc" class="<%= active === 'calc' ? 'active' : '' %>"><span class="nav-icon">=</span> Estimativa de custo</a>
        <a href="/download?file=welcome.txt" class="<%= active === 'download' ? 'active' : '' %>"><span class="nav-icon">v</span> Anexos</a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/profile/<%= user.id %>" class="<%= active === 'profile' ? 'active' : '' %>"><span class="nav-icon">@</span> Meu perfil</a>
        <% } else { %>
          <a href="/login" class="<%= active === 'login' ? 'active' : '' %>"><span class="nav-icon">@</span> Entrar</a>
        <% } %>
      </nav>
      <div class="sidebar-foot">
        <% if (typeof user !== 'undefined' && user) { %>
          Sessao ativa: <strong><%= user.username %></strong>
        <% } else { %>
          Deskly Helpdesk &middot; ambiente de estudo
        <% } %>
      </div>
    </aside>
    <main class="main">
